{
  "productName": "Dotlore",
  "identifier": "dev.dinhanhthi.dotlore",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:38421",
    "beforeDevCommand": "pnpm ui:dev",
    "beforeBuildCommand": "pnpm ui:build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Dotlore",
        "width": 1100,
        "height": 720,
        "minWidth": 880,
        "minHeight": 520,
        "visible": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 16, "y": 22 },
        "center": true
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "../assets/logo_256.png",
      "iconAsTemplate": false
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "icons/Assets.car": "Assets.car"
    },
    "category": "Utility",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/dinhanhthi/dotlore/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMwMUJDMkM1NDJGMURBNEQKUldSTjJ2RkN4Y0liTUFPY25NMXdMeEZQMERJV1phNXNwOEo4Z3VKMXZmK3dSaTVNdmZlNjlDSi8K"
    }
  }
}
