{
  "name": "dotlore",
  "private": true,
  "license": "MIT",
  "scripts": {
    "postinstall": "pnpm --dir crates/dotlore-app/ui install",
    "dev": "pnpm tauri dev",
    "ui:dev": "pnpm --dir crates/dotlore-app/ui dev",
    "ui:build": "pnpm --dir crates/dotlore-app/ui build",
    "mockapp:dev": "bash scripts/mockapp-dev.sh",
    "mockapp:build": "pnpm --dir crates/dotlore-app/ui exec tsc -p mockapp/tsconfig.json --noEmit && pnpm --dir crates/dotlore-app/ui exec vite build --config mockapp/vite.config.ts",
    "tauri": "bash scripts/tauri.sh",
    "build": "bash scripts/build.sh",
    "test": "bash scripts/test.sh",
    "smoke:two-devices": "cargo test -p dotlore-core --test two_devices two_devices_smoke_syncs_one_file -- --exact",
    "format": "cargo fmt",
    "format:check": "cargo fmt --check && pnpm --dir crates/dotlore-app/ui exec tsc --noEmit",
    "reset:dev": "bash scripts/reset-dev.sh"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2"
  }
}
