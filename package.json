{
  "name": "dotlore",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm tauri dev",
    "ui:dev": "vite",
    "ui:build": "bash scripts/ui-build.sh",
    "mockapp:dev": "bash scripts/mockapp-dev.sh",
    "mockapp:build": "tsc -p mockapp/tsconfig.json --noEmit && vite build --config mockapp/vite.config.ts",
    "tauri": "bash scripts/tauri.sh",
    "build": "bash scripts/build.sh",
    "test": "bash scripts/test.sh",
    "smoke:two-devices": "cargo test --manifest-path src-tauri/Cargo.toml --test two_devices two_devices_smoke_syncs_one_file -- --exact",
    "format": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:check": "cargo fmt --manifest-path src-tauri/Cargo.toml --check && tsc --noEmit",
    "reset:dev": "bash scripts/reset-dev.sh",
    "sweep:cargo": "bash scripts/sweep-cargo.sh"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@codemirror/lang-json": "^6.0.2",
