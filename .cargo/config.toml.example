# Copy to .cargo/config.toml (gitignored) and set the volume path for this
# machine. Every build of this repo (dev, test, clippy, rust-analyzer,
# release) goes to the external SSD.
# Use an absolute path: a relative one resolves from this repo root.
[build]
target-dir = "/Volumes/Thi2TB/cargo-target/dotlore"
